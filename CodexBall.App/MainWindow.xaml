<Window x:Class="CodexBall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexBall.App.Controls"
        Title="CodexBall"
        Icon="Assets/CodexBall.ico"
        Width="64"
        Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual">
    <Grid x:Name="Root"
          Width="64"
          Height="64"
          Background="Transparent"
          ToolTip="{Binding TooltipText}">
        <controls:ProgressRing Progress="{Binding Progress}"
                               RingBrush="{Binding RingBrush}"
                               Width="64"
                               Height="64" />
        <TextBlock Text="{Binding CenterText}"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextOptions.TextFormattingMode="Display" />
    </Grid>
</Window>
