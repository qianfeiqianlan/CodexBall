<Window x:Class="CodexBall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CodexBall.App.Services"
        xmlns:controls="clr-namespace:CodexBall.App.Controls"
        Title="CodexBall"
        Icon="Assets/CodexBall.ico"
        Width="64"
        Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="Manual">
    <Grid x:Name="Root"
          Width="64"
          Height="64"
          ToolTip="{Binding TooltipText}">
      <Grid x:Name="BallView" Background="Transparent">
        <controls:ProgressRing Progress="{Binding Progress}"
                               RingBrush="{Binding RingBrush}"
                               ResetProgress="{Binding ResetProgress}"
                               ResetRingBrush="{Binding ResetRingBrush}"
                               ShowResetRing="{Binding ShowResetRing, RelativeSource={RelativeSource AncestorType=Window}}"
                               Width="64"
                               Height="64" />
        <TextBlock Text="{Binding CenterText}"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextOptions.TextFormattingMode="Display" />
      </Grid>
      <Grid x:Name="CompanionView" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Canvas x:Name="CharacterCanvas" HorizontalAlignment="Center">
        <Image x:Name="CharacterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>
        <Border x:Name="UsageBar" Grid.Row="1" Margin="24,8,24,8" Background="Transparent"
                Cursor="Hand" ToolTip="{Binding [Click to view usage details], Source={x:Static services:AppLocalization.Current}}" AutomationProperties.Name="{Binding [Codex remaining quota], Source={x:Static services:AppLocalization.Current}}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Foreground="{Binding RingBrush}" Background="#99424957" BorderThickness="0"
                         IsHitTestVisible="False">
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                  <Border Background="{TemplateBinding Background}" CornerRadius="2">
                    <Grid x:Name="PART_Track">
                      <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                              CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
        </Border>
      </Grid>
      <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=UsageBar}" Placement="Top"
             AllowsTransparency="True" StaysOpen="False">
        <Border Background="#F5252935" BorderBrush="#FFE2C6D4" BorderThickness="1" CornerRadius="12" Padding="16" Width="245">
          <StackPanel>
            <TextBlock Text="{Binding [Codex usage], Source={x:Static services:AppLocalization.Current}}" Foreground="#FFFFDDE8" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
            <TextBlock Text="{Binding StatusText}" Foreground="White" />
            <TextBlock Text="{Binding ShortWindowLabel}" Foreground="#FFD7CED9" Margin="0,10,0,2" />
            <TextBlock Text="{Binding ShortWindowPercent}" Foreground="White" />
            <TextBlock Text="{Binding ShortWindowReset}" Foreground="#FFC6C2D0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LongWindowLabel}" Foreground="#FFD7CED9" Margin="0,10,0,2" />
            <TextBlock Text="{Binding LongWindowPercent}" Foreground="White" />
            <TextBlock Text="{Binding LongWindowReset}" Foreground="#FFC6C2D0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="#FFADA8B9" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Popup>
      <Border x:Name="EdgeRevealHandle" Visibility="Collapsed" Background="#CCB8D8D0"
              CornerRadius="3" Cursor="Hand" ToolTip="{Binding [Show CodexBall], Source={x:Static services:AppLocalization.Current}}" />
    </Grid>
</Window>
